{
  "name": "amesu",
  "version": "0.1.0",
  "description": "Amesu — a front-end visual-novel performance engine (for video / effects / demo assets).",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "scripts": {
    "build": "vite build && npm run lib",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "dev": "vite",
    "lib": "esbuild src/engine/index.ts --bundle --format=esm --outfile=dist/engine.js --target=es2022",
    "preview": "vite preview"
  },
  "keywords": [
    "visual-novel",
    "engine",
    "galgame",
    "rendering",
    "performance"
  ],
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.42",
    "vue-easy-lightbox": "^1.19.0"
  }
}
